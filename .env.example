# Atlas AI — variables de entorno de ejemplo.
# Copia este archivo a `.env` y ajusta los valores. `.env` está ignorado por git: NO subas secretos.
# Docker Compose y el backend leen `.env` de la raíz del repositorio.
# Con la pila completa de Compose (`docker compose up -d --build`) opcionalmente: API_PORT, FRONTEND_PORT y
# NEXT_PUBLIC_API_BASE_URL (esta última se fija al construir la imagen del frontend).
# Las variables de entorno del sistema tienen prioridad sobre `.env`.

# ── API (FastAPI) ────────────────────────────────────────────────────────────
# development | test | production
APP_ENV=development
# Origen del frontend permitido por CORS / comprobación de Origin.
FRONTEND_ORIGIN=http://localhost:3000
# Clave de firma de cookies/tokens. Obligatoria (>= 32 caracteres) en producción.
# Genérala con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Cookies: SameSite (lax | strict | none) y Secure (vacío = solo en producción).
# `none` exige Secure. Con frontend y API en sitios distintos usa none + HTTPS.
COOKIE_SAMESITE=lax
COOKIE_SECURE=
# Duración de la sesión de usuario en horas (168 = 7 días).
SESSION_TTL_HOURS=168

# ── Base de datos (PostgreSQL + pgvector, vía docker compose) ────────────────
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_dev_password
POSTGRES_DB=atlas
POSTGRES_TEST_DB=atlas_test
POSTGRES_PORT=5433
# Conexión del backend y de Alembic (mismos valores que arriba).
DATABASE_URL=postgresql+psycopg://atlas:atlas_dev_password@localhost:5433/atlas

# ── Almacenamiento de archivos ───────────────────────────────────────────────
STORAGE_DIR=storage
MAX_UPLOAD_MB=20

# ── Worker de ingestión (python -m app.ingestion.worker) ─────────────────────
INGESTION_POLL_SECONDS=2
INGESTION_LEASE_SECONDS=300
INGESTION_MAX_ATTEMPTS=3
# Archivo de latido del worker (lo toca tras cada vuelta sana); lo vigila el health check del contenedor.
INGESTION_HEARTBEAT_FILE=

# ── Límites del análisis de archivos (el exceso deja el documento en FAILED con la causa) ──
EXTRACTION_MAX_PAGES=500
EXTRACTION_MAX_CHARS=5000000
EXTRACTION_TIMEOUT_SECONDS=60
EXTRACTION_ISOLATED=true  # analizar en un subproceso con plazo; solo se desactiva en pruebas

# ── Fragmentación del texto (en caracteres; el solape no puede pasar de la mitad del tamaño) ──
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150

# ── Preguntas ────────────────────────────────────────────────────────────────
QUESTION_MAX_CHARS=1000

# Cuota diaria por usuario (día UTC): al agotarla, las preguntas devuelven 429 sin llamar al proveedor.
USAGE_DAILY_QUESTIONS=100
USAGE_DAILY_TOKENS=300000

# ── Búsqueda semántica ───────────────────────────────────────────────────────
SEARCH_DEFAULT_K=5
SEARCH_MAX_K=20
# Similitud coseno mínima (0 a 1) por defecto.
SEARCH_MIN_SCORE=0.0
# Máximo de documentos que una búsqueda puede seleccionar.
SEARCH_MAX_DOCUMENTS=50
# Reducción de resultados repetidos o contiguos: solape (0-1] a partir del cual un fragmento vecino
# se descarta, distancia de ordinal que cuenta como vecino y candidatos pedidos por resultado.
SEARCH_DEDUP_OVERLAP=0.5
SEARCH_DEDUP_WINDOW=1
SEARCH_OVERFETCH=3
# Reordenación de candidatos por solape léxico con la pregunta: off | lexical. Desactivada por defecto.
# Peso (0-1) del solape frente a la similitud vectorial y candidatos pedidos por resultado.
SEARCH_RERANK=off
SEARCH_RERANK_WEIGHT=0.5
SEARCH_RERANK_POOL=3

# Presupuesto (tokens estimados) del contexto que se envía al modelo; debe caber un fragmento.
ANSWER_CONTEXT_MAX_TOKENS=3000

# ── Proveedores de IA ────────────────────────────────────────────────────────
# fake = determinista y sin red (desarrollo y tests) | openai = API compatible con OpenAI
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small
# Debe coincidir con la dimensión de la columna vector de la base de datos.
EMBEDDING_DIMENSIONS=1536
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
# Solo con LLM_PROVIDER=fake: responde con lo que dicen las fuentes y las cita (E2E, demos).
FAKE_LLM_GROUNDED=false
# Parámetros de generación. Temperatura 0 = respuestas lo más reproducibles posible.
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT_SECONDS=60
# Reintentos ante fallos transitorios de embeddings/LLM (red, 429, 5xx). ATTEMPTS = llamadas totales
# (1 = sin reintentos); la espera se duplica desde BASE_SECONDS hasta MAX_SECONDS.
PROVIDER_RETRY_ATTEMPTS=3
PROVIDER_RETRY_BASE_SECONDS=0.5
PROVIDER_RETRY_MAX_SECONDS=8
# Solo si algún proveedor es `openai`. Nunca la subas al repositorio.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Pruebas (backend/tests) ──────────────────────────────────────────────────
# Base de datos aislada para pytest. Los tests fuerzan APP_ENV=test y proveedores `fake`.
TEST_DATABASE_URL=postgresql+psycopg://atlas:atlas_dev_password@localhost:5433/atlas_test
