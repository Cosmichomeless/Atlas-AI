{
  "openapi": "3.1.0",
  "info": {
    "title": "Atlas AI",
    "description": "Pregunta a tus documentos y obtén respuestas con citas.\n\nTodos los endpoints de negocio viven bajo `/api/v1`. Los errores comparten el esquema `ErrorResponse` (`{\"error\": {\"code\", \"message\", \"request_id\", \"details\"}}`).",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness probe",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "422": {
            "description": "Los datos enviados no son válidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/db": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness probe de base de datos",
        "description": "Comprueba la conexión a PostgreSQL y que la extensión pgvector está habilitada.",
        "operationId": "health_db_api_v1_health_db_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseHealthResponse"
                }
              }
            }
          },
          "422": {
            "description": "Los datos enviados no son válidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Servicio no disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DatabaseHealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "pgvector_version": {
            "type": "string",
            "title": "Pgvector Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "pgvector_version"
        ],
        "title": "DatabaseHealthResponse"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Identificador estable del error, p. ej. 'not_found'."
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Descripción legible del error."
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id",
            "description": "Identificador de la solicitud (cabecera X-Request-ID)."
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details",
            "description": "Detalle por campo; presente en errores de validación."
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorDetail": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc",
            "description": "Ubicación del problema, p. ej. ['body', 'email']."
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Tipo de error de validación."
          }
        },
        "type": "object",
        "required": [
          "loc",
          "message",
          "type"
        ],
        "title": "ErrorDetail",
        "description": "Un problema concreto, normalmente asociado a un campo de la solicitud."
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      }
    }
  }
}
